# Source a local copy before setup.sh, llm-chat or voice-synthesize.
IRODORI_BACKEND=cu128
# Fast conversation coexists with the LLM on CPU.
IRODORI_CHAT_MODEL_DEVICE=cpu
IRODORI_CHAT_MODEL_PRECISION=fp32
IRODORI_CHAT_CODEC_DEVICE=cpu
IRODORI_CHAT_CODEC_PRECISION=fp32
# Voice design and standalone synthesis unload the LLM, then occupy the GPU.
IRODORI_QUALITY_MODEL_DEVICE=cuda
IRODORI_QUALITY_MODEL_PRECISION=bf16
IRODORI_QUALITY_CODEC_DEVICE=cpu
IRODORI_QUALITY_CODEC_PRECISION=fp32
IRODORI_CPU_THREADS=4
LLM_IRODORI_URL=http://127.0.0.1:8088
VOICE_SYNTHESIZE_TTS_URL=http://127.0.0.1:8089
LLM_CHAT_URL=http://127.0.0.1:5070
# LLM_VOICE_LIBRARY_DIR=/path/to/voice-library
# VOICE_SYNTHESIZE_PRODUCTION_DIR=/path/to/productions
# VOICE_SYNTHESIZE_OUTPUT_DIR=/path/to/outputs  # legacy alias
# LLM_IRODORI_API_KEY=your-local-key
